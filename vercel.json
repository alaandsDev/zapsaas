{
  "version": 2,
  "builds": [
    { "src": "landing/index.html", "use": "@vercel/static" },
    { "src": "frontend/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/app(.*)", "dest": "/frontend/index.html" },
    { "src": "/", "dest": "/landing/index.html" },
    { "src": "/(.*)", "dest": "/landing/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
